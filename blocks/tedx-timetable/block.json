{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tedx/timetable",
    "title": "TEDx Timetable",
    "category": "widgets",
    "icon": "clock",
    "description": "Visual timeline schedule and timetable for TEDx events.",
    "keywords": ["timetable", "schedule", "agenda", "timeline", "tedx"],
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "title": {
            "type": "string",
            "default": "Timetable"
        },
        "eyebrow": {
            "type": "string",
            "default": ""
        },
        "showLine": {
            "type": "boolean",
            "default": true
        },
        "items": {
            "type": "array",
            "default": [
                { "time": "15:00", "title": "Start", "isHighlight": true },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "Break", "isHighlight": true },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "Start", "isHighlight": false },
                { "time": "15:00", "title": "End", "isHighlight": true }
            ]
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
