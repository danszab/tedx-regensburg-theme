{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tedx/bottom-navbar",
    "title": "TEDx Bottom Navbar",
    "category": "tedx",
    "icon": "menu-alt3",
    "description": "Fixed bottom navigation bar with iOS safe-area support, custom SVG icons, and smooth autoscroll links.",
    "keywords": [
        "navbar",
        "bottom",
        "navigation",
        "menu",
        "dock",
        "sticky",
        "fixed",
        "safari"
    ],
    "supports": {
        "html": false,
        "anchor": true
    },
    "attributes": {
        "showIcons": {
            "type": "boolean",
            "default": true
        },
        "buttons": {
            "type": "array",
            "default": [
                {
                    "label": "Schedule",
                    "url": "#timetable",
                    "newTab": false,
                    "iconType": "preset",
                    "presetIcon": "calendar",
                    "customIconId": 0,
                    "customIconUrl": ""
                },
                {
                    "label": "Speakers",
                    "url": "#speakers",
                    "newTab": false,
                    "iconType": "preset",
                    "presetIcon": "users",
                    "customIconId": 0,
                    "customIconUrl": ""
                },
                {
                    "label": "Floorplan",
                    "url": "#floorplan",
                    "newTab": false,
                    "iconType": "preset",
                    "presetIcon": "map",
                    "customIconId": 0,
                    "customIconUrl": ""
                },
                {
                    "label": "About",
                    "url": "#about",
                    "newTab": false,
                    "iconType": "preset",
                    "presetIcon": "info",
                    "customIconId": 0,
                    "customIconUrl": ""
                }
            ]
        }
    },
    "editorScript": "file:./index.js",
    "viewScript": "file:./script.js",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
